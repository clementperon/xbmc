WORKSPACE=${WORKSPACE:-$( cd $(dirname $0)/../../.. ; pwd -P )}
XBMC_PLATFORM_DIR=osx64
. $WORKSPACE/tools/buildsteps/defaultenv

DEPENDS_PREFIX=$(awk -F= '/^PREFIX=/{print $2}' "$WORKSPACE/tools/depends/Makefile.include")
mkdir -p "$WORKSPACE/build"
cmake -S "$WORKSPACE" -B "$WORKSPACE/build" \
  -DCMAKE_BUILD_TYPE="$Configuration" \
  -DCMAKE_TOOLCHAIN_FILE="$DEPENDS_PREFIX/share/Toolchain.cmake" \
  -DENABLE_INTERNAL_CROSSGUID=ON \
  -DENABLE_INTERNAL_FFMPEG=ON \
  -DCODE_SIGN_IDENTITY="$CODE_SIGN_IDENTITY" \
  -DNOTARYTOOL_KEYCHAIN_PROFILE="$NOTARYTOOL_KEYCHAIN_PROFILE" \
  -DNOTARYTOOL_KEYCHAIN_PATH="$NOTARYTOOL_KEYCHAIN_PATH"
